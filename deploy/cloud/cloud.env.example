# Copy these values into the CXApp runtime .env on the cloud host.
# Never commit the generated values.
APP_MODE=tenant
STACK=devkit
TENANT_ID=codexsun
DEVKIT_SYNC_ROLE=cloud
DEVKIT_SYNC_INSTANCE_ID=codexsun-cloud
DEVKIT_SYNC_TOKEN_PEPPER=generate-a-random-secret-of-at-least-32-characters
DEVKIT_SYNC_ENCRYPTION_KEY=generate-a-different-random-secret-of-at-least-32-characters
DEVKIT_STORAGE_PATH=/data/devkit

