# Runtime
NODE_ENV=development
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# DevKit Platform API and Web
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=9050
PLATFORM_API_URL=http://127.0.0.1:9050
PLATFORM_WEB_PORT=9060
PLATFORM_WEB_ORIGIN=http://127.0.0.1:9060
PLATFORM_WEB_ORIGINS=
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:9060/status
VITE_PLATFORM_API_URL=http://127.0.0.1:9050
VITE_COWORKER_API_URL=http://127.0.0.1:9050
# Desktop uses central web conversations by default. Set native only for offline local chat.
VITE_DESKTOP_CHAT_MODE=central
# Expo devices use this central API. Replace localhost with the development machine LAN address.
EXPO_PUBLIC_COWORKER_API_URL=http://127.0.0.1:9050
VITE_PLATFORM_WEB_URL=http://127.0.0.1:9060
VITE_DEV_AUTO_LOGIN=0
# Shows copyable page, section, card, workspace, and service IDs in web and desktop.
VITE_DEV_TECH_IDS=0

# Local development database.
# Container setup replaces these three values in .container/.env from deploy.env.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=devkit
DB_PASSWORD=
DB_NAME=devkit_db

# Authentication and protected administrator
JWT_SECRET=
DEVKIT_MODEL_PROVIDER_ENCRYPTION_KEY=

# Optional OpenCode coding-runtime bridge. The bundled OpenCode CLI can serve this endpoint.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@devkit.local
INITIAL_ADMIN_PASSWORD=


# DevKit-owned local integrations and storage.
DEVKIT_WORKSPACE_ROOT=..
DEVKIT_STORAGE_PATH=./storage/devkit
DEVKIT_SYNC_ROLE=local
DEVKIT_SYNC_INSTANCE_ID=local-devkit
DEVKIT_SYNC_ENCRYPTION_KEY=
DEVKIT_SYNC_TOKEN_PEPPER=
# Online devkit.codexsun.com runs with DEVKIT_SYNC_ROLE=cloud. Local installations remain local.

# Agent IDE model gateway. Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
CODEX_EXECUTABLE=bundled
# Optional local-AI services. These values do not replace the Codex runtime.
# Run `npm run local-ai:setup`, review its plan, then rerun with `-Apply` to create
# local Ollama and Qdrant services. Qdrant is for future semantic retrieval;
# MariaDB remains the product metadata and transaction store.
DEVKIT_LOCAL_AI_ENABLED=0
DEVKIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
DEVKIT_OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
DEVKIT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
DEVKIT_QDRANT_URL=http://127.0.0.1:6333
DEVKIT_QDRANT_COLLECTION=devkit_project_context
# Primary Codex authentication store. The secondary connector uses connections/secondary below it.
# Docker fixes this root to /var/lib/devkit/codex.
DEVKIT_CODEX_HOME=
# Hostinger VPS MCP. Keep the API token server-side and rotate exposed tokens before use.
HOSTINGER_API_TOKEN=
HOSTINGER_MCP_COMMAND=
HOSTINGER_MCP_PACKAGE=hostinger-api-mcp@1.33.1
# Writable Agent IDE runs use isolated Git worktrees. Docker fixes this to /srv/devkit/repositories.
DEVKIT_AGENT_ALLOWED_ROOTS=
# Docker fixes this to /var/lib/devkit/worktrees.
DEVKIT_AGENT_WORKTREE_ROOT=
# JSON array of shell-free quality gate commands. The built-in default runs git diff --check.
DEVKIT_AGENT_VERIFICATION_COMMANDS=
# Local commit identity. Agent commits are never pushed automatically.
DEVKIT_AGENT_GIT_NAME=CodeLogicX DevKit
DEVKIT_AGENT_GIT_EMAIL=devkit@localhost

# Telegram support bot. Create the bot with @BotFather. Keep the token server-side.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Notification delivery. MariaDB remains the queue authority when Redis is unavailable.
REDIS_URL=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CodeLogicX

# Container deployment overrides this with the mounted root .env path.
DEVKIT_ENV_FILE_PATH=

# Destructive database reset remains disabled
DEVKIT_DB_FRESH_ON_START=0
DEVKIT_DB_RESET_CONFIRM=
DEVKIT_ALLOW_PRODUCTION_DB_RESET=0
DEVKIT_OPENCODE_PATH=
