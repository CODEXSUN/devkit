NODE_ENV=development
DEVKIT_API_PORT=7030
DEVKIT_WEB_PORT=7040
DEVKIT_API_URL=http://127.0.0.1:7030
DEVKIT_WEB_ORIGIN=http://127.0.0.1:7040
DEVKIT_COOKIE_SECRET=replace-with-a-long-local-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=devkit_app
DB_PASSWORD=replace-with-devkit-db-password
DEVKIT_DB_NAME=devkit_db
DEVKIT_STORAGE_PATH=C:\Users\your-user\AppData\Local\CODEXSUN\Devkit\storage

DEVKIT_ADMIN_EMAIL=sundar@sundar.com
DEVKIT_ADMIN_NAME=SUNDAR
DEVKIT_ADMIN_PASSWORD=Kalarani1
DEVKIT_JWT_SECRET=
DEVKIT_SESSION_TTL_SECONDS=28800
# CXApp deployment metadata. The DevKit manifest owns its fixed-client scope.
CXAPP_STACK=devkit
CXAPP_SCOPE_MODE=single-client
CXAPP_IMAGE_TAG=local
CXAPP_REVISION=unknown
