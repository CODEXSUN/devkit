{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeLogicX Desktop",
  "version": "1.0.22",
  "identifier": "com.codelogicx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../../dist/devkit/desktop"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "CodeLogicX Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "CodeLogicX desktop engineering IDE",
    "targets": ["msi", "nsis"]
  }
}
