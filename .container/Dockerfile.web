ARG NODE_RUNTIME_VERSION=26.5.0
FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS build
ARG NPM_RUNTIME_VERSION=12.0.1
WORKDIR /workspace
RUN npm install --global npm@${NPM_RUNTIME_VERSION}
COPY framework ./framework
COPY ui ./ui
COPY devkit ./devkit
WORKDIR /workspace/devkit
RUN npm ci \
  && npm ci --prefix ../framework \
  && npm ci --prefix ../ui \
  && npm run build --prefix ../framework \
  && npm run build --workspace @codexsun/devkit-web

FROM nginx:1.28-alpine
ARG DEVKIT_VERSION=1.0.46
LABEL org.opencontainers.image.title="DevKit Web" org.opencontainers.image.version="$DEVKIT_VERSION"
COPY devkit/.container/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/devkit/dist/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
