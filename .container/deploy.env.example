NODE_ENV=production
DEVKIT_VERSION=1.0.46
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
DEVKIT_IMAGE_REGISTRY=devkit
DEVKIT_BIND_ADDRESS=127.0.0.1
DEVKIT_API_PORT=7030
DEVKIT_WEB_PORT=7040
DEVKIT_API_HOST_PORT=17030
DEVKIT_WEB_HOST_PORT=17040
DEVKIT_WEB_ORIGIN=https://devkit.codexsun.com
DEVKIT_COOKIE_SECRET=change_this_devkit_cookie_secret
JWT_SECRET=change_this_devkit_jwt_secret
DEVKIT_DB_NAME=devkit_db
DEVKIT_STORAGE_PATH=/storage
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_USER=cxapp_app
DB_PASSWORD=inherited_from_cxapp
MARIADB_CONTAINER_NAME=cxapp-mariadb
REDIS_CONTAINER_NAME=cxapp-redis
MEDIA_CONTAINER_NAME=cxapp-media
CODEXSUN_BACKEND_NETWORK=cxapp-network
CODEXSUN_EDGE_NETWORK=cxapp-edge
DEVKIT_DATA_VOLUME=devkit-data
DEVKIT_VERIFIED_BACKUP_ID=
