# Docker project and images
DEVKIT_COMPOSE_PROJECT=devkit
DEVKIT_IMAGE_REGISTRY=devkit
DEVKIT_VERSION=1.0.21
DEVKIT_IMAGE_TAG=1.0.21
DEVKIT_MIGRATION_COMPATIBLE_VERSION=1.0.21
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.2
DEVKIT_BACKUP_RETENTION=10
DEVKIT_UPDATE_MIN_BACKUP_FREE_MB=1024
DEVKIT_UPDATE_MIN_DOCKER_FREE_MB=5120

# Docker resources
DEVKIT_API_CONTAINER_NAME=devkit-api
DEVKIT_WEB_CONTAINER_NAME=devkit-web
DEVKIT_MARIADB_CONTAINER_NAME=devkit-mariadb
DEVKIT_NETWORK=cxapp-network
DEVKIT_NETWORK_EXTERNAL=true
DEVKIT_MARIADB_DATA_VOLUME=devkit-mariadb-data

# Loopback publishing
DEVKIT_BIND_ADDRESS=127.0.0.1
DEVKIT_API_INTERNAL_PORT=7050
DEVKIT_API_HOST_PORT=7050
DEVKIT_WEB_HOST_PORT=7060

# Standalone MariaDB infrastructure
MARIADB_IMAGE=mariadb:11.8
MARIADB_ROOT_PASSWORD=generate-with-setup
DB_USER=devkit
DB_PASSWORD=generate-with-setup
DB_NAME=devkit_db

# Reuse CXApp-owned MariaDB infrastructure while keeping the DevKit database separate.
DEVKIT_SHARED_MARIADB_CONTAINER_NAME=cxapp-mariadb
DEVKIT_SHARED_MARIADB_ENV_FILE=../../cxapp/.container/deploy.env
DEVKIT_SHARED_MARIADB_ROOT_PASSWORD=
