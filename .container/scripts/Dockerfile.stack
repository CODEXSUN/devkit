# syntax=docker/dockerfile:1.7
ARG NODE_RUNTIME_VERSION=26.5.0
FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS build

ARG NPM_RUNTIME_VERSION=12.0.2
WORKDIR /workspace/devkit
RUN npm install --global npm@${NPM_RUNTIME_VERSION}

# DevKit is a self-contained monorepo. Framework and UI are internal workspaces.
COPY . .

RUN --mount=type=cache,id=devkit-app-npm,target=/root/.npm \
  npm ci && npm run build

FROM build AS verify
RUN npm run check

FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS api-runtime
ARG NPM_RUNTIME_VERSION=12.0.2
WORKDIR /workspace/devkit
RUN npm install --global npm@${NPM_RUNTIME_VERSION} && \
  apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
  rm -rf /var/lib/apt/lists/*
COPY --chown=node:node --from=build /workspace/devkit /workspace/devkit
USER node
EXPOSE 9050
CMD ["node", "dist/platform/api/server.js"]

FROM nginx:1.28-alpine AS web-runtime
COPY .container/scripts/nginx-spa.conf /etc/nginx/templates/default.conf.template
COPY --from=build /workspace/devkit/dist/platform/web /usr/share/nginx/html
EXPOSE 80
