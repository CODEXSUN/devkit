{
  "name": "@codexsun/devkit",
  "version": "1.0.44",
  "private": true,
  "packageManager": "npm@12.0.1",
  "description": "Standalone CODEXSUN developer planning and collaboration stack",
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "node tools/dev-stack.mjs",
    "dev:api": "node tools/preflight.mjs devkit-api",
    "dev:web": "node tools/preflight.mjs devkit-web",
    "build": "npm run build --workspace @codexsun/devkit-api && npm run build --workspace @codexsun/devkit-web",
    "typecheck": "npm run typecheck --workspace @codexsun/devkit-api && npm run typecheck --workspace @codexsun/devkit-web",
    "lint": "npm run lint --workspace @codexsun/devkit-api && npm run lint --workspace @codexsun/devkit-web",
    "check": "npm run test:queue-contract && npm run typecheck && npm run lint",
    "check:module-boundaries": "node tools/check-module-boundaries.mjs",
    "db:migrate": "node tools/database.mjs migrate",
    "db:seed": "node tools/database.mjs seed",
    "test:runtime": "node tools/runtime-smoke.mjs",
    "test:queue-contract": "node --test tools/queue-contract.test.mjs",
    "dependencies:check": "node tools/check-root-artifacts.mjs",
    "version:show": "node tools/version/version.mjs show",
    "version:bump": "node tools/version-bump.mjs",
    "changelog:append": "node tools/version/version.mjs append",
    "check:versions": "node tools/check-versions.mjs",
    "github:now": "node tools/github-helper.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint-compiler": "npm:typescript@6.0.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=12.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
