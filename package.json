{
  "name": "devkit",
  "version": "1.0.89",
  "private": true,
  "packageManager": "npm@12.0.2",
  "description": "CodeLogicX developer and engineering orchestration workspace",
  "type": "module",
  "workspaces": [
    "apps/*/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev:web": "node tools/preflight.mjs platform-web",
    "dev:api": "node tools/preflight.mjs platform-api",
    "dev:desktop": "node tools/start-desktop-dev.mjs",
    "dev:mobile": "npm run start --workspace @devkit/mobile",
    "desktop:dev": "node tools/start-desktop-dev.mjs",
    "desktop:build": "npm run tauri:build --workspace @devkit/desktop",
    "desktop:release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-desktop-release.ps1",
    "desktop:release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-desktop-release.ps1",
    "desktop:release:publish": "node tools/publish-desktop-release.mjs",
    "desktop:check": "npm run check --workspace @devkit/desktop",
    "codeit:dev": "npm run tauri:dev --workspace @codeit/desktop",
    "codeit:build": "npm run tauri:build --workspace @codeit/desktop",
    "codeit:check": "npm run check --workspace @codeit/desktop",
    "dev:restart": "node tools/dev-stack.mjs",
    "dev:restart:api": "node tools/preflight.mjs platform-api",
    "dev:restart:web": "node tools/preflight.mjs platform-web",
    "preinstall": "node tools/enforce-root-install.mjs",
    "postinstall": "node tools/clean-workspace-artifacts.mjs && node tools/check-root-node-modules.mjs",
    "setup": "node tools/install-stack.mjs",
    "local-ai:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File .container/local-ai/setup-local-ai.ps1",
    "local-ai:start": "powershell -NoProfile -ExecutionPolicy Bypass -File .container/local-ai/run-local-ai.ps1 -Action start",
    "local-ai:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File .container/local-ai/run-local-ai.ps1 -Action stop",
    "local-ai:status": "powershell -NoProfile -ExecutionPolicy Bypass -File .container/local-ai/run-local-ai.ps1 -Action status",
    "local-ai:pull": "powershell -NoProfile -ExecutionPolicy Bypass -File .container/local-ai/run-local-ai.ps1 -Action pull",
    "local-ai:test": "powershell -NoProfile -ExecutionPolicy Bypass -File .container/local-ai/run-local-ai.ps1 -Action test",
    "dev": "node tools/dev-stack.mjs",
    "clean": "node tools/clean-root-dist.mjs && node tools/clean-workspace-artifacts.mjs",
    "build": "npm run clean && node tools/stack-command.mjs build",
    "typecheck": "node tools/stack-command.mjs typecheck",
    "lint": "node tools/stack-command.mjs lint",
    "check": "npm run check:text-encoding && npm run check:deployment && npm run check:repository-boundary && npm run dependencies:check && npm run check:module-boundaries && npm run check:database-lifecycle && npm run typecheck && npm run lint && npm test",
    "check:text-encoding": "node tools/check-env-encoding.mjs",
    "check:env-encoding": "npm run check:text-encoding",
    "check:deployment": "node tools/check-deployment-scripts.mjs",
    "check:repository-boundary": "node tools/check-repository-boundary.mjs",
    "check:module-boundaries": "node tools/check-module-boundaries.mjs",
    "check:core-boundaries": "node tools/check-module-boundaries.mjs core",
    "check:database-lifecycle": "node tools/check-database-lifecycle.mjs",
    "dependencies:clean": "node tools/clean-workspace-artifacts.mjs",
    "dependencies:check": "node tools/check-root-node-modules.mjs",
    "test": "npm test --workspace @codexsun/framework && npm run test:exports --workspace @codexsun/framework && npm run package:check --workspace @codexsun/framework",
    "test:e2e:runtime": "node tools/e2e/runtime-smoke.e2e.mjs",
    "test:e2e:launch-desk": "node tools/e2e/launch-desk-stream.e2e.mjs",
    "test:e2e:codex-chat": "node tools/e2e/codex-chat.e2e.mjs",
    "test:e2e:codeit-chat": "node tools/e2e/codeit-chat.e2e.mjs",
    "test:e2e:codeit-playwright": "node tools/e2e/codeit-playwright.e2e.mjs",
    "test:e2e:agent-worktree": "node tools/e2e/agent-worktree.e2e.mjs",
    "test:e2e:agent-team": "node tools/e2e/agent-team.e2e.mjs",
    "test:e2e:honey-mascot": "playwright test honey-mascot.e2e.mjs",
    "version:show": "node tools/repository-release.mjs version:show",
    "version:bump": "node tools/repository-release.mjs version:bump",
    "version-bump": "node tools/repository-release.mjs version:bump",
    "check:versions": "node tools/repository-release.mjs check:versions",
    "release:scope": "node tools/release-scope.mjs",
    "github:now": "node tools/github-helper.mjs",
    "github:release": "node tools/github-release.mjs",
    "github:release:test": "node --test tools/github-release.test.mjs",
    "stack:impact": "node tools/stack-impact.mjs",
    "stack:plan": "node tools/stack-release-plan.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate": "tsx apps/platform/api/src/database/db-cli.ts migrate",
    "db:migrations:list": "tsx apps/platform/api/src/database/db-cli.ts migrations:list",
    "db:seed": "tsx apps/platform/api/src/database/db-cli.ts seed",
    "db:drop": "tsx apps/platform/api/src/database/db-cli.ts drop",
    "dbmigrate:fresh": "tsx apps/platform/api/src/database/db-cli.ts fresh",
    "github:ssh-key": "node tools/github-ssh-key.mjs",
    "env:jwt-secret": "node tools/env-jwt-secret.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-text-style": "^3.30.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "opencode-ai": "^1.18.25",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint-compiler": "npm:typescript@^6.0.3",
    "vite": "^8.2.2",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=12.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "fast-uri": "4.1.2",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.1",
    "nanoid": "6.0.1"
  },
  "allowScripts": {
    "bullmq": false,
    "esbuild": true,
    "msgpackr-extract": false,
    "opencode-ai@1.18.21": true
  }
}
